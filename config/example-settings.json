{
  "id": "kepeto.kalender",
  "mode": "hybrid",
  "locale": "",
  "calendarIds": ["primary"],
  "syncIntervalMinutes": 5,
  "syncCommand": "python3 ~/.config/omarchy/plugins/kepeto.kalender/scripts/kalender-sync.py --client-secret ~/.config/kalender/client_secret.json",
  "eventCache": "~/.cache/kalender/events.json",
  "notificationsEnabled": true,
  "notifyMinutes": [60, 30, 15, 0],
  "allDayNotificationTime": "08:00",
  "eventTitleLimit": 20,
  "marqueeEnabled": true,
  "marqueeOnStart": true,
  "marqueeEveryMinutes": 15
}
